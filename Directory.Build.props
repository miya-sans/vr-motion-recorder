<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VRMR</RootNamespace>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 1591 missing XML docs; CA1416 platform compatibility -->
    <NoWarn>$(NoWarn);1591;CA1416</NoWarn>
    <!-- all build output under artifacts/ (bin, obj, publish), nothing next to the sources -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>
  <PropertyGroup>
    <Product>VR Motion Recorder</Product>
    <Authors>VR Motion Recorder contributors</Authors>
    <Copyright>Copyright (c) VR Motion Recorder contributors. MIT License.</Copyright>
    <VersionPrefix>0.9.0</VersionPrefix>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
