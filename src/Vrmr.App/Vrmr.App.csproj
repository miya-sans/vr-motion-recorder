<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VRMotionRecorder</AssemblyName>
    <RootNamespace>VRMR.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>../../assets/icon/vrmr.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../assets/icon/vrmr.ico" Link="Assets/vrmr.ico"/>
    <InternalsVisibleTo Include="Vrmr.App.Tests"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia"/>
    <PackageReference Include="Avalonia.Desktop"/>
    <PackageReference Include="Avalonia.Themes.Fluent"/>
    <PackageReference Include="Avalonia.Fonts.Inter"/>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Vrmr.Core/Vrmr.Core.csproj"/>
    <ProjectReference Include="../Vrmr.Model/Vrmr.Model.csproj"/>
    <ProjectReference Include="../Vrmr.Avatars/Vrmr.Avatars.csproj"/>
    <ProjectReference Include="../Vrmr.Fbik/Vrmr.Fbik.csproj"/>
    <ProjectReference Include="../Vrmr.Solve/Vrmr.Solve.csproj"/>
    <ProjectReference Include="../Vrmr.Capture/Vrmr.Capture.csproj"/>
    <ProjectReference Include="../Vrmr.Scene/Vrmr.Scene.csproj"/>
    <ProjectReference Include="../Vrmr.Export/Vrmr.Export.csproj"/>
    <ProjectReference Include="../Vrmr.Render/Vrmr.Render.csproj"/>
  </ItemGroup>
</Project>
