<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The app's icon set: outline icons on a 16 x 16 grid, drawn for this project (MIT, like the rest of the repository).
    The Icon control strokes them at 1.5 px with round caps; keys ending in "Solid" are filled instead.
  -->

  <!-- transport -->
  <StreamGeometry x:Key="Icon.PlaySolid">M5,3 L13,8 L5,13 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.PauseSolid">M4,3 H7 V13 H4 Z M9,3 H12 V13 H9 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.SkipStart">M4,3 V13 M12,3.5 L6.5,8 L12,12.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.SkipEnd">M12,3 V13 M4,3.5 L9.5,8 L4,12.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.StepBack">M10,3.5 L5.5,8 L10,12.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.StepForward">M6,3.5 L10.5,8 L6,12.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Loop">M3,7.5 V6.5 A2,2 0 0 1 5,4.5 H12.5 M10.5,2.5 L12.5,4.5 L10.5,6.5 M13,8.5 V9.5 A2,2 0 0 1 11,11.5 H3.5 M5.5,9.5 L3.5,11.5 L5.5,13.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.RecordSolid">M3,8 A5,5 0 1 0 13,8 A5,5 0 1 0 3,8 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.StopSolid">M4,4 H12 V12 H4 Z</StreamGeometry>
