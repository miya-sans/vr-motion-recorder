<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VRMR.App.Controls"
        xmlns:vm="using:VRMR.App.ViewModels"
        xmlns:v="using:VRMR.App.Views"
        xmlns:takes="using:VRMR.App.Views.Takes"
        xmlns:scene="using:VRMR.App.Views.Scene"
        xmlns:vp="using:VRMR.App.Viewport"
        x:Class="VRMR.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="VR Motion Recorder"
        Icon="/Assets/vrmr.ico"
        Width="1400" Height="860" MinWidth="1100" MinHeight="700">
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ============================================================ top bar -->
    <Border Grid.Row="0" Classes="panel" Height="{DynamicResource TopBarHeight}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource HairlineBottom}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <c:IconToggle x:Name="SettingsToggle" Classes="settings" Icon="{DynamicResource Icon.Settings}"
                        IsChecked="{Binding SettingsOpen, Mode=TwoWay}" AutomationProperties.Name="Settings"
                        ToolTip.Tip="Settings (Ctrl+,)" />
          <c:IconButton Icon="{DynamicResource Icon.Help}" Command="{Binding ToggleHelpCommand}"
                        ToolTip.Tip="Keyboard shortcuts and help (F1)" />
        </StackPanel>
        <c:SegmentedControl Grid.Column="1" x:Name="WorkspaceSwitch" IsVisible="{Binding SceneAvailable}"
                            SelectedIndex="{Binding WorkspaceIndex}" Margin="16,0,0,0" VerticalAlignment="Center"
                            MinWidth="160">
          <ListBoxItem ToolTip.Tip="Record, trim and solve single takes">Takes</ListBoxItem>
          <ListBoxItem ToolTip.Tip="Arrange takes on tracks, blend and keyframe them">Scene</ListBoxItem>
        </c:SegmentedControl>
        <ItemsControl Grid.Column="3" ItemsSource="{Binding Sources}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SourcePillViewModel">
              <c:StatusPill Label="{Binding Label}" StateText="{Binding StateText}" State="{Binding Level}"
                            AutomationProperties.Name="{Binding Label}">
                <c:StatusPill.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight" ShowMode="TransientWithDismissOnPointerMoveAway">
                    <StackPanel MaxWidth="320" Spacing="8">
                      <TextBlock Text="{Binding Label}" Classes="title" />
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18" />
                      <Border Classes="card" IsVisible="{Binding HasFix}">
                        <Grid ColumnDefinitions="Auto,*">
                          <c:Icon Data="{DynamicResource Icon.Info}" Foreground="{DynamicResource AccentBrush}"
                                  VerticalAlignment="Top" Margin="0,2,8,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Fix}" TextWrapping="Wrap" LineHeight="18" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Flyout>
                </c:StatusPill.Flyout>
              </c:StatusPill>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <!-- ============================================================ workspace -->
    <Grid Grid.Row="1" x:Name="MainGrid" ColumnDefinitions="260,Auto,*,Auto,320">
      <!-- library -->
      <Border Grid.Column="0" x:Name="LibraryHost" Classes="panel" IsVisible="{Binding LibraryOpen}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,8,12,0">
            <c:IconToggle x:Name="LiveButton" Classes="liveMode"
                          HorizontalAlignment="Stretch" Icon="{DynamicResource Icon.Live}" Content="Live"
                          IsChecked="{Binding Takes.IsLive}" IsVisible="{Binding IsTakes}" IsEnabled="{Binding !IsRecording}"
                          ToolTip.Tip="Show live devices. Select a take to review it, or click Live again to return to the last take." />
            <c:IconButton Grid.Column="1" Icon="{DynamicResource Icon.PanelLeft}" Margin="6,0,0,0"
                          Command="{Binding ToggleLibraryCommand}" ToolTip.Tip="Hide library (Ctrl+1)" />
          </Grid>
          <v:LibraryPanel DataContext="{Binding Library}" />
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" x:Name="LibrarySplitter" Width="1" ResizeDirection="Columns"
                    IsVisible="{Binding LibraryOpen}" />

      <!-- centre: view, transport, timeline -->
      <Grid Grid.Column="2" x:Name="CentreGrid" RowDefinitions="*,Auto,168">
        <Grid RowDefinitions="*,Auto">
          <Panel Grid.Row="0" x:Name="ViewHost" ClipToBounds="True">
            <vp:GpuView x:Name="View" />
            <!-- Takes: overlay controls of the 3D view -->
            <Panel IsVisible="{Binding IsTakes}">
              <takes:ViewOverlay DataContext="{Binding Takes}" />
            </Panel>
            <scene:SceneWorkspaceView x:Name="SceneView" IsVisible="{Binding IsScene}" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Top" Margin="8">
              <c:IconButton Icon="{DynamicResource Icon.PanelLeft}" Command="{Binding ToggleLibraryCommand}"
                            IsVisible="{Binding !LibraryOpen}" ToolTip.Tip="Show library (Ctrl+1)"
                            VerticalAlignment="Top" Margin="0,0,6,0" />
              <TextBlock Grid.Column="1" x:Name="ViewStatus" Text="{Binding #View.Scene.Overlay}" Classes="secondary"
                         IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding #View.Scene.OverlayRight}" Classes="secondary"
                         MaxWidth="240" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
              <c:IconButton Grid.Column="3" Icon="{DynamicResource Icon.PanelRight}" Command="{Binding ToggleInspectorCommand}"
                            IsVisible="{Binding !InspectorOpen}" ToolTip.Tip="Show inspector (Ctrl+2)"
                            VerticalAlignment="Top" Margin="6,0,0,0" />
            </Grid>
            <v:ToastHost VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" />
          </Panel>
          <Border Grid.Row="1" Classes="panel" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="{DynamicResource HairlineTop}">
            <Grid ColumnDefinitions="*,Auto">
              <Panel IsVisible="{Binding IsTakes}" ClipToBounds="True">
                <Panel IsVisible="{Binding !ShowLiveTransport}">
                  <takes:TransportBar DataContext="{Binding Takes}" />
                </Panel>
                <Grid IsVisible="{Binding ShowLiveTransport}" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                      HorizontalAlignment="Left" Height="40" Margin="8,0">
                  <c:IconButton x:Name="RecordButton" Classes="record" Classes.recording="{Binding IsRecording}"
                                Icon="{DynamicResource Icon.RecordSolid}" IconFilled="True"
                                Content="{Binding RecordText}" Command="{Binding ToggleRecordCommand}"
                                ToolTip.Tip="{Binding RecordTip}" MinWidth="100" VerticalAlignment="Center"
                                FontFeatures="{DynamicResource TabularFigures}" />
                  <ComboBox x:Name="RecordDelay" Grid.Column="1" SelectedIndex="{Binding RecordDelayIndex}" VerticalAlignment="Center"
                            ToolTip.Tip="Recording countdown" AutomationProperties.Name="Recording countdown">
                    <ComboBoxItem>0 s</ComboBoxItem>
                    <ComboBoxItem>1 s</ComboBoxItem>
                    <ComboBoxItem>3 s</ComboBoxItem>
                    <ComboBoxItem>5 s</ComboBoxItem>
                  </ComboBox>
                  <Button Grid.Column="2" Command="{Binding CalibrateLiveCommand}" IsEnabled="{Binding CanCalibrate}"
                          Margin="8,0,0,0" MaxWidth="155" VerticalAlignment="Center" ToolTip.Tip="{Binding LiveCalibrationText}">
                    <TextBlock Text="{Binding LiveCalibrationText}" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <ComboBox x:Name="CalibrationDelay" Grid.Column="3" SelectedIndex="{Binding CalibrationDelayIndex}" VerticalAlignment="Center"
                            IsEnabled="{Binding CanSetCalibrationDelay}" ToolTip.Tip="Calibration countdown"
                            AutomationProperties.Name="Calibration countdown">
                    <ComboBoxItem>Sync with VRChat</ComboBoxItem>
                    <ComboBoxItem>1 s</ComboBoxItem>
                    <ComboBoxItem>3 s</ComboBoxItem>
                    <ComboBoxItem>5 s</ComboBoxItem>
                  </ComboBox>
                  <TextBlock Grid.Column="4" Text="{Binding CalibrationAge}" Classes="secondary tabular"
                             Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Minutes since last calibration" />
                </Grid>
              </Panel>
              <ContentControl x:Name="SceneTransportHost" IsVisible="{Binding IsScene}" ClipToBounds="True" />
              <c:IconButton Grid.Column="1" x:Name="TimelineToggle" Icon="{DynamicResource Icon.PanelBottom}"
                            Command="{Binding ToggleTimelineCommand}" ToolTip.Tip="{Binding TimelineTip}"
                            AutomationProperties.Name="{Binding TimelineTip}" VerticalAlignment="Center" Margin="4,0" />
            </Grid>
          </Border>
        </Grid>
        <GridSplitter Grid.Row="1" x:Name="TimelineSplitter" Height="4" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      IsVisible="{Binding TimelineOpen}" />
        <Panel Grid.Row="2" x:Name="TimelineHost" IsVisible="{Binding TimelineOpen}">
          <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsTakes}">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,2" IsVisible="{Binding Takes.HasTake}">
              <TextBlock Text="{Binding Takes.TimeText}" Classes="secondary tabular" ToolTip.Tip="{Binding Takes.TimeTip}" />
              <TextBlock x:Name="FrameCounter" Text="{Binding Takes.FrameText}" Classes="secondary tabular" />
            </StackPanel>
            <c:TimelineControl Grid.Row="1" x:Name="Timeline" Model="{Binding Takes.Timeline}" />
          </Grid>
          <ContentControl x:Name="SceneTimelineHost" IsVisible="{Binding IsScene}" />
        </Panel>
      </Grid>

      <!-- inspector -->
      <GridSplitter Grid.Column="3" x:Name="InspectorSplitter" Width="1" ResizeDirection="Columns"
                    IsVisible="{Binding InspectorOpen}" />
      <Border Grid.Column="4" x:Name="InspectorHost" Classes="panel" IsVisible="{Binding InspectorOpen}">
        <Panel>
          <Panel IsVisible="{Binding IsTakes}">
            <takes:TakesInspector x:Name="TakesInspectorView" DataContext="{Binding Takes}" />
          </Panel>
          <ContentControl x:Name="SceneInspectorHost" IsVisible="{Binding IsScene}" Margin="0,36,0,0" />
          <c:IconButton Icon="{DynamicResource Icon.PanelRight}" Command="{Binding ToggleInspectorCommand}"
                        ToolTip.Tip="Hide inspector (Ctrl+2)" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" />
        </Panel>
      </Border>

      <!-- pages over the workspace -->
      <ContentControl Grid.ColumnSpan="5" x:Name="PageHost" IsVisible="{Binding SettingsOpen}" />
      <ContentControl Grid.ColumnSpan="5" x:Name="FirstRunHost" IsVisible="{Binding FirstRun.IsOpen}" />
      <v:HelpOverlay Grid.ColumnSpan="5" IsVisible="{Binding HelpOpen}" />
    </Grid>

    <!-- ============================================================ status bar -->
    <Border Grid.Row="2" Classes="panel" Height="{DynamicResource StatusBarHeight}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource HairlineTop}">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,0">
        <TextBlock x:Name="StatusMessage" Text="{Binding StatusText}" Classes="secondary" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Classes.error="{Binding StatusKind, Converter={x:Static v:Converters.IsError}}"
                   Classes.warning="{Binding StatusKind, Converter={x:Static v:Converters.IsWarning}}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    IsVisible="{Binding HasProgress}" Margin="12,0">
          <TextBlock Text="{Binding ProgressText}" Classes="secondary" VerticalAlignment="Center" />
          <ProgressBar Width="120" Minimum="0" Maximum="1" Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding ProgressIndeterminate}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    DataContext="{Binding Takes}">
          <ProgressBar Width="80" Minimum="0" Maximum="1" Value="{Binding SolveProgress}"
                       IsVisible="{Binding IsSolving}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SolveText}" Classes="secondary tabular" VerticalAlignment="Center"
                     Classes.error="{Binding SolveFailed}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
