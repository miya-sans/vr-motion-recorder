<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VRMR.App.Controls"
             xmlns:vm="using:VRMR.App.ViewModels"
             xmlns:s="using:VRMR.App.Views.Settings"
             x:Class="VRMR.App.Views.FirstRun.FirstRunView"
             x:DataType="vm:FirstRunViewModel"
             IsVisible="{Binding IsOpen, FallbackValue=False}">
  <!-- The setup guide over the workspace on first run: three short steps, none required. Leaving it is always one click. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Views/Settings/SettingsMetrics.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.fact">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="{DynamicResource StatusLineHeight}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource ScrimBrush}">
    <Border Classes="popover" Width="{DynamicResource FirstRunWidth}" HorizontalAlignment="Center"
            VerticalAlignment="Center" Padding="{DynamicResource FirstRunPad}">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource SettingsTitleGap}">
          <TextBlock Text="Welcome to VR Motion Recorder" Classes="page" />
          <TextBlock Grid.Column="1" Text="{Binding StepText}" Classes="caption tabular" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding StepTitle}" Classes="title" Margin="{DynamicResource SettingsBlockGap}" />

        <Panel MinHeight="{DynamicResource FirstRunBodyHeight}">
          <!-- 1: what was found -->
          <StackPanel IsVisible="{Binding ShowsFound}">
            <TextBlock Text="{Binding FoundSummary}" Classes="note" Classes.warning="{Binding FoundNeedsAttention}"
                       Margin="{DynamicResource StatusRowGap}" />
            <ItemsControl x:Name="FoundList" ItemsSource="{Binding Found}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatusRowViewModel">
                  <s:StatusRow Margin="{DynamicResource StatusRowGap}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
              <c:IconButton Classes="outlined" Icon="{DynamicResource Icon.Refresh}" Content="Check again"
                            Command="{Binding CheckAgainCommand}"
                            ToolTip.Tip="Look at this computer again, after starting VRChat or installing something" />
              <TextBlock Text="Checking…" Classes="secondary" VerticalAlignment="Center"
                         IsVisible="{Binding IsChecking}" />
            </StackPanel>
          </StackPanel>

          <!-- 2: where takes are kept -->
          <StackPanel IsVisible="{Binding ShowsFolder}">
            <TextBlock Classes="note"
                       Text="New projects use Recordings and Avatars subfolders. Change individual folders under Settings → Folders." />
            <Border Classes="card" Margin="{DynamicResource SettingsBlockGap}">
              <Grid ColumnDefinitions="Auto,*">
                <c:Icon Data="{DynamicResource Icon.Folder}" Foreground="{DynamicResource TextSecondaryBrush}"
                        VerticalAlignment="Top" Margin="{DynamicResource Pad1}" />
                <SelectableTextBlock Grid.Column="1" x:Name="FolderText" Text="{Binding ProjectFolder}"
                                     TextWrapping="Wrap" VerticalAlignment="Center"
                                     Margin="{DynamicResource GapLeftSmall}" />
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space3}" IsVisible="{Binding CanMoveFolder}"
                        Margin="{DynamicResource GapRow}">
              <Button Content="Browse…" Command="{Binding BrowseFolderCommand}"
                      ToolTip.Tip="Choose the project folder" />
              <Button Classes="link" Content="Use the default folder" Command="{Binding UseDefaultFolderCommand}"
                      IsVisible="{Binding FolderMoved}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="note" Text="Portable mode: takes stay inside the data folder the app was started with."
                       IsVisible="{Binding IsPortable}" />
            <Panel IsVisible="{Binding RecordingsState.NeedsAttention}">
              <s:StatusRow DataContext="{Binding RecordingsState}" />
            </Panel>
            <Panel IsVisible="{Binding AvatarsState.NeedsAttention}">
              <s:StatusRow DataContext="{Binding AvatarsState}" />
            </Panel>
          </StackPanel>

          <!-- 3: the avatar -->
          <StackPanel IsVisible="{Binding ShowsAvatar}">
            <TextBlock Classes="note"
                       Text="Takes are solved onto a base model: your avatar's skeleton and mesh. Add the files your avatar came with: its .unitypackage (or the .zip it came in) together with its face-tracking add-on, or a Unity model (.fbx with its .meta). The files are only read, and no Unity project is needed." />
            <c:IconButton x:Name="AddAvatarButton" Classes="accent" Icon="{DynamicResource Icon.Plus}"
                          Content="Add avatar…" Command="{Binding AddAvatarCommand}" IsEnabled="{Binding !IsImporting}"
                          HorizontalAlignment="Left" Margin="{DynamicResource SettingsBlockGap}" />
            <Border Classes="card" IsVisible="{Binding IsImporting}" Margin="{DynamicResource GapRow}">
              <StackPanel Spacing="{DynamicResource Space2}">
                <TextBlock Text="{Binding ImportMessage}" TextTrimming="CharacterEllipsis" />
                <ProgressBar IsIndeterminate="True" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="Auto,*" Margin="{DynamicResource GapRow}">
              <c:Icon Data="{DynamicResource Icon.Avatar}" Foreground="{DynamicResource TextSecondaryBrush}"
                      VerticalAlignment="Top" Margin="{DynamicResource StatusIconMargin}" />
              <TextBlock Grid.Column="1" Text="{Binding AvatarState}" Classes="fact" />
            </Grid>
            <TextBlock Classes="note"
                       Text="You can go on without one: add or change avatars at any time under Settings → Avatars." />
          </StackPanel>
        </Panel>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="{DynamicResource GapTop}">
          <Button x:Name="SkipButton" Classes="ghost" Content="Skip setup" Command="{Binding SkipCommand}"
                  ToolTip.Tip="Close the guide. Everything in it is also under Settings, and the guide can be run again from Settings → About." />
          <Button Grid.Column="2" Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
          <Button Grid.Column="3" x:Name="NextButton" Classes="accent" Content="Next" Command="{Binding NextCommand}"
                  IsVisible="{Binding !IsLastStep}" Margin="{DynamicResource GapLeft}" />
          <Button Grid.Column="3" x:Name="FinishButton" Classes="accent" Content="Finish"
                  Command="{Binding FinishCommand}" IsVisible="{Binding IsLastStep}" Margin="{DynamicResource GapLeft}" />
        </Grid>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
