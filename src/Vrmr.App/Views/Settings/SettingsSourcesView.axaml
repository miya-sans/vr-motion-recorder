<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VRMR.App.Controls"
             xmlns:vm="using:VRMR.App.ViewModels"
             xmlns:s="using:VRMR.App.Views.Settings"
             x:Class="VRMR.App.Views.Settings.SettingsSourcesView"
             x:DataType="vm:SettingsSourcesViewModel">
  <!-- Sources: each switch with what that source finds right now. -->
  <StackPanel>
    <Border Classes="card" IsVisible="{Binding CaptureOff}" Margin="{DynamicResource SettingsBlockGap}">
      <TextBlock Classes="fact"
                 Text="Live sources are off in this session (the app was started with --no-capture). The switches are saved and used from the next normal start; the states show what is installed." />
    </Border>

    <c:Section Header="SteamVR" StateKey="settings.sources.steamvr">
      <StackPanel>
        <CheckBox Content="Record SteamVR devices" IsChecked="{Binding SteamVrOn}"
                  ToolTip.Tip="The headset, controllers, trackers and base stations: what the IK solve works from. The app joins a running SteamVR in the background and never starts SteamVR itself. Off: takes hold face tracking and avatar parameters only." />
        <s:StatusRow DataContext="{Binding SteamVr}" Margin="{DynamicResource SettingsIndent}" />
        <CheckBox Content="Finger tracking" IsChecked="{Binding FingerTracking}" IsEnabled="{Binding SteamVrOn}"
                  ToolTip.Tip="Records how far each finger is curled and spread, from controllers that track fingers. It only reads: your SteamVR bindings are not changed. Off: fingers come from VRChat's hand gestures." />
        <Panel IsVisible="{Binding ShowFingerState}" Margin="{DynamicResource SettingsIndent}">
          <s:StatusRow DataContext="{Binding Fingers}" />
        </Panel>
      </StackPanel>
    </c:Section>

    <c:Section Header="VRChat" StateKey="settings.sources.vrchat">
      <StackPanel>
        <s:StatusRow DataContext="{Binding VrChat}" Margin="{DynamicResource SettingsBlockGap}" />
        <CheckBox Content="{Binding LegacyPortLabel}" IsChecked="{Binding LegacyPort}"
                  ToolTip.Tip="VRChat's default OSC output port: a second way in for when VRChat is not found by itself. It only works while no other program uses the port. A change applies after restarting the app." />
        <StackPanel Margin="{DynamicResource SettingsIndent}">
          <s:StatusRow DataContext="{Binding LegacyPortState}" />
          <TextBlock Text="Restart the app to apply a change." Classes="caption" Margin="{DynamicResource GapTopSmall}" />
        </StackPanel>
      </StackPanel>
    </c:Section>

    <c:Section Header="Face tracking" StateKey="settings.sources.face">
      <s:StatusRow DataContext="{Binding Face}" />
    </c:Section>
  </StackPanel>
</UserControl>
