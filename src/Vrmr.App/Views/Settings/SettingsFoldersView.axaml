<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VRMR.App.Controls"
             xmlns:vm="using:VRMR.App.ViewModels"
             xmlns:core="using:VRMR"
             xmlns:s="using:VRMR.App.Views.Settings"
             x:Class="VRMR.App.Views.Settings.SettingsFoldersView"
             x:DataType="vm:SettingsFoldersViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.project-bridge">
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <Style Selector="TextBlock.project-bridge.installed">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.project-bridge.missing">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel>
    <Border Classes="card" IsVisible="{Binding IsPortable}" Margin="{DynamicResource SettingsBlockGap}">
      <TextBlock Classes="fact"
                 Text="Portable mode: takes and avatars stay inside the data folder the app was started with, so these two folders cannot be moved." />
    </Border>

    <c:Section Header="Takes and avatars" StateKey="settings.folders.work">
      <StackPanel>
        <c:FieldRow Label="Project folder">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding ProjectFolder, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsPortable}" />
            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseProjectCommand}"
                    IsVisible="{Binding CanMoveFolders}" Margin="{DynamicResource GapLeft}" />
          </Grid>
        </c:FieldRow>
        <TextBlock Classes="note" Text="Library folders can be relative to the project or absolute paths." />
        <c:FieldRow Label="Recordings folder" CanReset="{Binding RecordingsMoved}"
                    ResetCommand="{Binding ResetRecordingsCommand}"
                    ToolTip.Tip="Where new takes are saved, and where the library looks for takes. Takes already recorded stay in the old folder until you move them yourself.">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Text="{Binding RecordingsFolder, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsPortable}" />
            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseRecordingsCommand}"
                    IsVisible="{Binding CanMoveFolders}" Margin="{DynamicResource GapLeft}" />
            <c:IconButton Grid.Column="2" Icon="{DynamicResource Icon.Folder}"
                          Command="{Binding OpenRecordingsCommand}" ToolTip.Tip="Open the recordings folder"
                          Margin="{DynamicResource GapLeftSmall}" />
          </Grid>
        </c:FieldRow>
        <Panel IsVisible="{Binding Recordings.NeedsAttention}" Margin="{DynamicResource GapRow}">
          <s:StatusRow DataContext="{Binding Recordings}" />
        </Panel>

        <c:FieldRow Label="Avatar library folder" CanReset="{Binding AvatarsMoved}"
                    ResetCommand="{Binding ResetAvatarsCommand}"
                    ToolTip.Tip="Where the base models added under Avatars are kept: one folder per avatar with its model, its textures and its skeleton.">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Text="{Binding AvatarFolder, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsPortable}" />
            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseAvatarsCommand}"
                    IsVisible="{Binding CanMoveFolders}" Margin="{DynamicResource GapLeft}" />
            <c:IconButton Grid.Column="2" Icon="{DynamicResource Icon.Folder}" Command="{Binding OpenAvatarsCommand}"
                          ToolTip.Tip="Open the avatar library folder" Margin="{DynamicResource GapLeftSmall}" />
          </Grid>
        </c:FieldRow>
        <Panel IsVisible="{Binding Avatars.NeedsAttention}" Margin="{DynamicResource GapRow}">
          <s:StatusRow DataContext="{Binding Avatars}" />
        </Panel>
      </StackPanel>
    </c:Section>

    <c:Section Header="Blender" StateKey="settings.folders.blender">
      <StackPanel>
        <s:StatusRow DataContext="{Binding Blender}" Margin="{DynamicResource GapRow}" />
        <c:FieldRow Label="Blender program" CanReset="{Binding HasBlenderPath}"
                    ResetCommand="{Binding ClearBlenderCommand}"
                    ToolTip.Tip="The Blender that exports are opened in. Leave it empty to use the newest release found on this computer; set blender.exe or its folder to use another one.">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding BlenderPath, UpdateSourceTrigger=LostFocus}" PlaceholderText="Found by itself" />
            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseBlenderCommand}"
                    Margin="{DynamicResource GapLeft}" />
          </Grid>
        </c:FieldRow>
        <TextBlock Text="{Binding BlenderInUse, StringFormat='In use: {0}'}" Classes="caption"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding BlenderInUse, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </c:Section>

    <c:Section Header="Unity projects" StateKey="settings.folders.unity">
      <StackPanel>
        <TextBlock Classes="note"
                   Text="Optional. Link the Unity project your avatar lives in: the app then knows the avatar you wear by its VRChat id and reads its humanoid rig from the model's .meta. Unity does not need to be running." />
        <s:StatusRow DataContext="{Binding Unity}" Margin="{DynamicResource GapRow}" />
        <WrapPanel Margin="{DynamicResource GapRow}">
          <TextBlock Text="Add project from" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Content="Folder" Command="{Binding AddProjectCommand}" Margin="0,0,8,4"
                  ToolTip.Tip="Pick a Unity project folder containing Assets and ProjectSettings" />
          <Button Content="Unity Hub" Command="{Binding AddFromManagerCommand}"
                  CommandParameter="{x:Static core:UnityProjectSource.UnityHub}" Margin="0,0,8,4" />
          <Button Content="ALCOM" Command="{Binding AddFromManagerCommand}"
                  CommandParameter="{x:Static core:UnityProjectSource.Alcom}" Margin="0,0,8,4" />
          <Button Content="VRChat Creator Companion" Command="{Binding AddFromManagerCommand}"
                  CommandParameter="{x:Static core:UnityProjectSource.CreatorCompanion}" Margin="0,0,0,4" />
        </WrapPanel>
        <ListBox x:Name="ProjectList" Classes="plain" ItemsSource="{Binding Projects}"
                 SelectedItem="{Binding SelectedProject}" IsVisible="{Binding HasProjects}"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Margin="{DynamicResource GapRow}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:UnityProjectRowViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="{DynamicResource SettingsListItemPad}">
                <TextBlock Text="{Binding Indicator}" Classes="project-bridge"
                           Classes.installed="{Binding HasBridge}" Classes.missing="{Binding Missing}"
                           ToolTip.Tip="{Binding BridgeStatus}"
                           AutomationProperties.Name="{Binding BridgeStatus}" />
                <StackPanel Grid.Column="1" Margin="{DynamicResource GapLeft}">
                  <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Details}" Classes="secondary" Classes.warning="{Binding Missing}"
                             TextWrapping="Wrap" Margin="{DynamicResource GapTopSmall}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Remove" Margin="{DynamicResource GapLeftSmall}" VerticalAlignment="Center"
                        Command="{Binding $parent[ListBox].((vm:SettingsFoldersViewModel)DataContext).RemoveProjectCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Forget this project. Project files and existing avatar links stay unchanged."
                        AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </c:Section>
  </StackPanel>
</UserControl>
