<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VRMR.App.Controls"
             xmlns:vm="using:VRMR.App.ViewModels"
             x:Class="VRMR.App.Views.Settings.SettingsViewOptionsView"
             x:DataType="vm:SettingsViewOptionsViewModel">
  <!-- View: the theme, and single meshes of the avatar on screen that the 3D view leaves out. -->
  <StackPanel>
    <c:Section Header="Appearance" StateKey="settings.view.appearance">
      <c:FieldRow Label="Theme" ToolTip.Tip="Dark suits a dim room with a headset nearby. Follow system switches between dark and light with your Windows setting.">
        <c:SegmentedControl x:Name="ThemeSwitch" SelectedIndex="{Binding ThemeIndex}" HorizontalAlignment="Left">
          <ListBoxItem>Dark</ListBoxItem>
          <ListBoxItem>Light</ListBoxItem>
          <ListBoxItem>Follow system</ListBoxItem>
        </c:SegmentedControl>
      </c:FieldRow>
    </c:Section>

    <c:Section Header="Hidden meshes" StateKey="settings.view.meshes">
      <StackPanel>
        <TextBlock Classes="note" Text="Untick a mesh of the avatar on screen to leave it out of the 3D view: an outfit piece that covers the body, say. The Mesh chip in the view switches the whole avatar; this only changes what you see, not the take." />
        <TextBlock Text="{Binding MeshInfo}" Classes="note" IsVisible="{Binding MeshInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ItemsControl x:Name="MeshList" ItemsSource="{Binding Meshes}" IsVisible="{Binding HasMeshes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MeshRowViewModel">
              <CheckBox Content="{Binding Name}" IsChecked="{Binding Shown}" ToolTip.Tip="{Binding Tip}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="link" Content="Show all meshes" Command="{Binding ShowAllMeshesCommand}" IsVisible="{Binding AnyHidden}" HorizontalAlignment="Left" Margin="{DynamicResource GapTop}" />
      </StackPanel>
    </c:Section>
  </StackPanel>
</UserControl>
