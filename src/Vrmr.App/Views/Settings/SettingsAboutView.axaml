<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VRMR.App.Controls"
             xmlns:vm="using:VRMR.App.ViewModels"
             x:Class="VRMR.App.Views.Settings.SettingsAboutView"
             x:DataType="vm:SettingsViewModel">
  <!-- About: the version, where the app keeps its files, the log and the way back into the setup guide. -->
  <StackPanel>
    <c:Section Header="VR Motion Recorder" StateKey="settings.about.app">
      <StackPanel>
        <c:FieldRow Label="Version">
          <SelectableTextBlock x:Name="VersionText" Text="{Binding Version}" VerticalAlignment="Center" />
        </c:FieldRow>
        <c:FieldRow Label="Licence">
          <TextBlock Text="MIT licence: free to use, change and share." VerticalAlignment="Center" TextWrapping="Wrap" />
        </c:FieldRow>
      </StackPanel>
    </c:Section>

    <c:Section Header="Help" StateKey="settings.about.help">
      <StackPanel>
        <TextBlock Classes="note"
                   Text="The log says what the app did and what went wrong: attach it when you report a problem. The setup guide checks SteamVR, VRChat, Blender and Unity again and walks through the folders and the avatar." />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
          <Button Content="Open log" Command="{Binding OpenLogCommand}" />
          <Button Content="Open settings folder" Command="{Binding OpenAppDataCommand}"
                  ToolTip.Tip="Settings, calibrations and logs" />
          <Button Content="Run the setup guide again" Command="{Binding RunSetupGuideCommand}" />
        </StackPanel>
      </StackPanel>
    </c:Section>
  </StackPanel>
</UserControl>
