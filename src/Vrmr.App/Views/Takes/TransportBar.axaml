<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VRMR.App.Controls"
             xmlns:vm="using:VRMR.App.ViewModels"
             x:Class="VRMR.App.Views.Takes.TransportBar"
             x:DataType="vm:TakesWorkspaceViewModel">
  <!-- Playback | trim and cut | placement and calibration, the time on the right, undo and redo last. -->
  <Grid ColumnDefinitions="*,Auto" Height="40" Margin="8,0">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <c:IconButton x:Name="SkipStartButton" Icon="{DynamicResource Icon.SkipStart}"
                      Command="{Binding SeekStartCommand}" IsEnabled="{Binding HasTake}"
                      ToolTip.Tip="Go to the start (Home)" />
        <c:IconButton x:Name="StepBackButton" Icon="{DynamicResource Icon.StepBack}" Command="{Binding StepBackCommand}"
                      IsEnabled="{Binding CanPlay}" ToolTip.Tip="One frame back (←)" />
        <Panel>
          <c:IconButton x:Name="PlayButton" Classes="accent" Icon="{DynamicResource Icon.PlaySolid}" IconFilled="True"
                        Command="{Binding TogglePlayCommand}" IsEnabled="{Binding HasTake}"
                        ToolTip.Tip="Play (Space)" MinWidth="40" IsVisible="{Binding !IsPlaying}" />
          <c:IconButton Classes="accent" Icon="{DynamicResource Icon.PauseSolid}" IconFilled="True"
                        Command="{Binding TogglePlayCommand}"
                        ToolTip.Tip="Pause (Space)" MinWidth="40" IsVisible="{Binding IsPlaying}" />
        </Panel>
        <c:IconButton x:Name="StepForwardButton" Icon="{DynamicResource Icon.StepForward}"
                      Command="{Binding StepForwardCommand}" IsEnabled="{Binding CanPlay}"
                      ToolTip.Tip="One frame forward (→)" />
        <c:IconButton x:Name="SkipEndButton" Icon="{DynamicResource Icon.SkipEnd}" Command="{Binding SeekEndCommand}"
                      IsEnabled="{Binding HasTake}" ToolTip.Tip="Go to the end (End)" />
        <c:IconToggle Icon="{DynamicResource Icon.Loop}" IsChecked="{Binding Loop}"
                      ToolTip.Tip="Loop: start again at the end" Margin="6,0,0,0" />
        <ComboBox ItemsSource="{Binding SpeedLabels}" SelectedIndex="{Binding SpeedIndex}" Width="72"
                  ToolTip.Tip="Playback speed" VerticalAlignment="Center" />

        <Rectangle Classes="divider" Width="1" Height="18" Margin="8,0" />
        <c:IconButton Icon="{DynamicResource Icon.TrimIn}" Command="{Binding SetInCommand}" IsEnabled="{Binding HasTake}"
                      ToolTip.Tip="Start the take at the playhead (I)" />
        <c:IconButton Icon="{DynamicResource Icon.TrimOut}" Command="{Binding SetOutCommand}"
                      IsEnabled="{Binding HasTake}" ToolTip.Tip="End the take at the playhead (O)" />
        <c:IconButton Icon="{DynamicResource Icon.Cut}" Command="{Binding CutCommand}" IsEnabled="{Binding HasSelection}"
                      ToolTip.Tip="Remove the selected range (Del). Drag in the timeline's lanes to select; right-click a cut to bring it back." />
        <c:IconButton Icon="{DynamicResource Icon.Keep}" Command="{Binding KeepCommand}"
                      IsEnabled="{Binding HasSelection}" ToolTip.Tip="Keep only the selected range" />
        <c:IconButton Icon="{DynamicResource Icon.Reset}" Command="{Binding ResetEditsCommand}"
                      IsEnabled="{Binding HasTake}" ToolTip.Tip="Remove every trim and cut" />

        <Rectangle Classes="divider" Width="1" Height="18" Margin="8,0" />
        <c:IconButton x:Name="OriginButton" Icon="{DynamicResource Icon.Origin}" Content="Origin"
                      Command="{Binding OriginHereCommand}" IsEnabled="{Binding CanPlay}"
                      ToolTip.Tip="Put the avatar on the origin at the playhead: hips over the centre, feet on the floor, facing forward. Moves the whole take; the inspector's Placement section has exact values and a gizmo." />
        <c:IconButton Icon="{DynamicResource Icon.TurnLeft}" Command="{Binding TurnLeftCommand}"
                      IsEnabled="{Binding CanPlay}"
                      ToolTip.Tip="Turn the take 90° to the left about the hips at the playhead" />
        <c:IconButton Icon="{DynamicResource Icon.TurnRight}" Command="{Binding TurnRightCommand}"
                      IsEnabled="{Binding CanPlay}"
                      ToolTip.Tip="Turn the take 90° to the right about the hips at the playhead" />
        <c:IconButton x:Name="CalibrateButton" Icon="{DynamicResource Icon.Pose}" Content="Calibrate"
                      Command="{Binding CalibrateHereCommand}" IsEnabled="{Binding HasTake}"
                      ToolTip.Tip="Use the pose at the playhead as the T-pose the trackers are bound to" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
      <c:IconButton Icon="{DynamicResource Icon.Undo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                    ToolTip.Tip="Undo the last edit of this take (Ctrl+Z)" />
      <c:IconButton Icon="{DynamicResource Icon.Redo}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                    ToolTip.Tip="Redo (Ctrl+Shift+Z or Ctrl+Y)" />
    </StackPanel>
  </Grid>
</UserControl>
