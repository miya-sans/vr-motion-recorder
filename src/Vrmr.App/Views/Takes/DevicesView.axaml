<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VRMR.App.Controls"
             xmlns:s="using:VRMR.App.Views.Settings"
             xmlns:vm="using:VRMR.App.ViewModels"
             x:Class="VRMR.App.Views.Takes.DevicesView"
             x:DataType="vm:DevicesViewModel">
  <!-- What VRChat and SteamVR send right now: the avatar worn, the devices with battery and tracking, the face. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Views/Settings/SettingsMetrics.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="c|Section:expanded /template/ TextBlock#PART_Summary">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{DynamicResource PadPanel}">
      <TextBlock Text="Live capture is off" Classes="note" IsVisible="{Binding !CaptureOn}" />
      <c:Section Header="Avatar" StateKey="live.avatar">
        <StackPanel>
          <c:FieldRow Label="Base model" IsVisible="{Binding HasBaseModels}"
                      ToolTip.Tip="The avatar the live view and new takes are solved onto. Picking one links it to the avatar you wear now, and it is remembered.">
            <ComboBox ItemsSource="{Binding BaseModels}" SelectedIndex="{Binding BaseModelIndex}"
                      PlaceholderText="Select base model" />
          </c:FieldRow>
          <s:StatusRow DataContext="{Binding AvatarStatus}" Margin="0,4,0,0" />
        </StackPanel>
      </c:Section>

      <c:Section Header="SteamVR devices" StateKey="live.devices" Summary="{Binding DevicesSummary}">
        <StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel>
              <CheckBox Content="Record devices" IsChecked="{Binding SteamVrOn}" />
              <s:StatusRow DataContext="{Binding SteamVr}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <CheckBox Content="Finger tracking" IsChecked="{Binding FingerTracking}" IsEnabled="{Binding SteamVrOn}"
                        ToolTip.Tip="Preview finger curl from thumb to little finger and record skeletal hand motion." />
              <s:StatusRow DataContext="{Binding Fingers}" />
            </StackPanel>
          </Grid>
          <s:StatusRow DataContext="{Binding PlayArea}" Margin="0,8,0,0" />
          <s:StatusRow DataContext="{Binding Tracking}" Margin="{DynamicResource SettingsBlockGap}" />
          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceRowViewModel">
                <Border Classes="card" Margin="0,0,0,4">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <Panel Grid.RowSpan="2" Width="10" Height="10" Margin="2,0,10,0" VerticalAlignment="Center">
                      <Ellipse Fill="{DynamicResource TextBrush}" Opacity="0.9" IsVisible="{Binding Tracked}" />
                      <Ellipse Fill="{DynamicResource LimbLeftBrush}" IsVisible="{Binding IsLeft}" />
                      <Ellipse Fill="{DynamicResource LimbRightBrush}" IsVisible="{Binding IsRight}" />
                      <Ellipse Fill="{DynamicResource WarningBrush}" IsVisible="{Binding IsTracker}" />
                      <Ellipse Fill="{DynamicResource RaisedBrush}" Stroke="{DynamicResource TextFaintBrush}"
                               StrokeThickness="1.5" IsVisible="{Binding !Tracked}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Detail}" ToolTip.Tip="{Binding Detail}" Classes="secondary"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                IsVisible="{Binding HasBattery}">
                      <ProgressBar Width="34" MinWidth="34" Height="6" MinHeight="6" Minimum="0" Maximum="1"
                                   Value="{Binding Battery}" VerticalAlignment="Center"
                                   Classes.low="{Binding BatteryLow}" Classes.mid="{Binding BatteryMid}"
                                   Classes.ok="{Binding !BatteryLow}" />
                      <TextBlock Text="{Binding BatteryText}" Classes="secondary tabular" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding TrackingText}"
                               FontSize="{DynamicResource FontCaption}" HorizontalAlignment="Right" Margin="8,2,0,0"
                               Classes.success="{Binding TrackingOk}" Classes.warning="{Binding TrackingDegraded}"
                               Classes.error="{Binding TrackingLost}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </c:Section>

      <c:Section Header="Face tracking" StateKey="live.face" IsExpanded="False" Summary="{Binding FaceStatus.Summary}">
        <StackPanel>
          <s:StatusRow DataContext="{Binding FaceStatus}" />
          <ItemsControl ItemsSource="{Binding Face}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FaceValueViewModel">
                <Grid ColumnDefinitions="140,*" Height="18">
                  <TextBlock Text="{Binding Name}" Classes="caption" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Value}" Height="6" MinHeight="6"
                               VerticalAlignment="Center" Classes="mid" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </c:Section>

      <c:Section Header="VRChat input" StateKey="live.connections" IsExpanded="False"
                 Summary="{Binding ConnectionsSummary}">
        <StackPanel>
          <s:StatusRow DataContext="{Binding Discovery}"
                       ToolTip.Tip="Finds VRChat locally to read the current avatar ID, eye height and parameters." />
          <s:StatusRow DataContext="{Binding Osc}"
                       ToolTip.Tip="Receives avatar changes, expression parameters and tracking poses from VRChat." />
          <CheckBox Content="{Binding LegacyPortLabel}" IsChecked="{Binding LegacyPort}"
                    ToolTip.Tip="Receives VRChat’s OSC output here if the advertised input receives no messages." />
          <s:StatusRow DataContext="{Binding LegacyPortStatus}" Margin="{DynamicResource SettingsBlockGap}" />
        </StackPanel>
      </c:Section>

      <c:Section Header="Diagnostics" StateKey="live.connectionDetails" IsExpanded="False" IsVisible="{Binding CaptureOn}">
        <StackPanel>
          <c:Section Header="VRChat" Level="2">
            <SelectableTextBlock Text="{Binding Connections}" Classes="mono" TextWrapping="Wrap" LineHeight="16" />
          </c:Section>
          <c:Section Header="SteamVR" Level="2">
            <SelectableTextBlock Text="{Binding SteamVrDiagnostics}" Classes="mono" TextWrapping="Wrap" LineHeight="16" />
          </c:Section>
          <c:Section Header="Face tracking" Level="2">
            <SelectableTextBlock Text="{Binding FaceDiagnostics}" Classes="mono" TextWrapping="Wrap" LineHeight="16" />
          </c:Section>
        </StackPanel>
      </c:Section>
    </StackPanel>
  </ScrollViewer>
</UserControl>
