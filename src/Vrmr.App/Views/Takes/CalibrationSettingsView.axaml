<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:VRMR.App.Controls"
             xmlns:vm="using:VRMR.App.ViewModels"
             x:Class="VRMR.App.Views.Takes.CalibrationSettingsView"
             x:DataType="vm:CalibrationSettingsViewModel">
  <!-- The calibration settings editor, shared by the Take inspector (the take's own settings) and Settings (the defaults). -->
  <StackPanel>
    <c:FieldRow Label="Height"
                ToolTip.Tip="How your size is found. VRChat's User Real Height is what VRChat itself uses; Measure takes the headset's height at the calibration moment.">
      <ComboBox ItemsSource="{Binding HeightModes}" SelectedIndex="{Binding HeightModeIndex}" />
    </c:FieldRow>
    <c:FieldRow Label="{Binding HeightValueLabel}" ToolTip.Tip="{Binding HeightValueTip}">
      <Panel>
        <c:NumberField Value="{Binding HeightValue}" Minimum="0" Maximum="5" Step="0.01"
                       Decimals="{Binding HeightValueDecimals}" Unit="{Binding HeightValueUnit}"
                       IsVisible="{Binding HeightValueEditable}" HorizontalAlignment="Left" Width="110" />
        <TextBlock Text="{Binding HeightReadout}" Classes="secondary" VerticalAlignment="Center" TextWrapping="Wrap"
                   IsVisible="{Binding !HeightValueEditable}" />
      </Panel>
    </c:FieldRow>
    <c:FieldRow Label="Spine"
                ToolTip.Tip="With a hip tracker. Lock head keeps the head on the headset; Lock hips keeps the hips on their tracker; Lock both bends the spine to keep both. The VRChat option follows recorded changes and falls back to the last manual choice.">
      <ComboBox ItemsSource="{Binding SpineModes}" SelectedIndex="{Binding SpineIndex}" />
    </c:FieldRow>
    <c:FieldRow Label="Measure"
                ToolTip.Tip="Match the avatar by height or by arm span. The VRChat option follows recorded changes and falls back to the last manual choice.">
      <ComboBox ItemsSource="{Binding MeasureModes}" SelectedIndex="{Binding MeasureIndex}" />
    </c:FieldRow>
    <c:FieldRow Label="Trackers"
                ToolTip.Tip="Which trackers drive the body. Their roles stay as they are; a tracker that is off is ignored by the solve.">
      <WrapPanel>
        <c:ToggleChip Content="Hips" IsChecked="{Binding UseHips}" Margin="0,2,4,2" Classes="solid" />
        <c:ToggleChip Content="Chest" IsChecked="{Binding UseChest}" Margin="0,2,4,2" Classes="solid" />
        <c:ToggleChip Content="Feet" IsChecked="{Binding UseFeet}" Margin="0,2,4,2" Classes="solid" />
        <c:ToggleChip Content="Knees" IsChecked="{Binding UseKnees}" Margin="0,2,4,2" Classes="solid" />
        <c:ToggleChip Content="Elbows" IsChecked="{Binding UseElbows}" Margin="0,2,4,2" Classes="solid" />
      </WrapPanel>
    </c:FieldRow>

    <c:Section Header="Advanced" Level="2" IsExpanded="False" StateKey="take.cal.advanced"
               Summary="{Binding AdvancedSummary}" SummaryTone="Accent">
      <StackPanel>
        <CheckBox Content="Keep feet on their trackers" IsChecked="{Binding KeepFeetPlanted}"
                  ToolTip.Tip="With Lock head: when a leg cannot reach its foot tracker, the hips come down a little instead of the foot leaving its tracker, as VRChat does. Lock hips and Lock both keep the hips and let the foot lift." />
        <CheckBox Content="Ignore head tilt at calibration" IsChecked="{Binding UprightCalibration}"
                  ToolTip.Tip="Turns the head upright before the trackers are bound. A calibration is often confirmed while looking down at the menu." />
        <CheckBox Content="Hang from the headset, like VRChat" IsChecked="{Binding HangFromHeadset}"
                  ToolTip.Tip="VRChat binds the trackers with the avatar hanging from your headset, so its feet can end up a little below the floor with straight legs. Off: the avatar is stood on the floor at calibration and the knees bend instead." />
        <CheckBox Content="VRChat's head and hand offsets" IsChecked="{Binding VrcHands}"
                  ToolTip.Tip="Use VRChat's headset and Index controller offsets. Uncheck to edit the offsets." />
        <c:FieldRow Label="Head offset" ToolTip.Tip="{Binding HeadOffsetTip}">
          <Grid ColumnDefinitions="*,4,*,4,*">
            <c:NumberField Grid.Column="2" Value="{Binding HeadOffsetY}" Step="0.1" Decimals="2" Unit="cm"
                           IsEnabled="{Binding !VrcHands}" ShowSign="True"
                           ToolTip.Tip="Y · Up" ToolTip.ShowOnDisabled="True" />
            <c:NumberField Grid.Column="4" Value="{Binding HeadOffsetZ}" Step="0.1" Decimals="2" Unit="cm"
                           IsEnabled="{Binding !VrcHands}" ShowSign="True"
                           ToolTip.Tip="Z · Forward" ToolTip.ShowOnDisabled="True" />
          </Grid>
        </c:FieldRow>
        <c:FieldRow Label="Hand offset" ToolTip.Tip="{Binding HandOffsetTip}">
          <Grid ColumnDefinitions="*,4,*,4,*">
            <c:NumberField Value="{Binding HandOffsetX}" Step="0.1" Decimals="2" Unit="cm"
                           IsEnabled="{Binding !VrcHands}" ShowSign="True"
                           ToolTip.Tip="X · Right" ToolTip.ShowOnDisabled="True" />
            <c:NumberField Grid.Column="2" Value="{Binding HandOffsetY}" Step="0.1" Decimals="2" Unit="cm"
                           IsEnabled="{Binding !VrcHands}" ShowSign="True"
                           ToolTip.Tip="Y · Up" ToolTip.ShowOnDisabled="True" />
            <c:NumberField Grid.Column="4" Value="{Binding HandOffsetZ}" Step="0.1" Decimals="2" Unit="cm"
                           IsEnabled="{Binding !VrcHands}" ShowSign="True"
                           ToolTip.Tip="Z · Forward" ToolTip.ShowOnDisabled="True" />
          </Grid>
        </c:FieldRow>
        <CheckBox Content="Shoulder movement" IsChecked="{Binding ShoulderTracking}"
                  ToolTip.Tip="Lets the shoulders shrug and reach with the arms." />
        <CheckBox Content="Steps without foot trackers" IsChecked="{Binding ProceduralFeet}"
                  ToolTip.Tip="Makes the feet step by themselves when the take has no foot trackers. Tracked feet always follow their trackers." />
        <CheckBox Content="Follow VRChat's avatar scaling" IsChecked="{Binding FollowAvatarScale}"
                  IsEnabled="{Binding RecordingOptionsEnabled}"
                  Margin="{DynamicResource GapRowSmall}"
                  ToolTip.Tip="Off: the avatar keeps its own size even when you resized it in VRChat during the take. On: the body follows those size changes." />
        <c:FieldRow Label="Avatar scale" CanReset="{Binding AvatarScaleChanged}"
                    ResetCommand="{Binding ResetAvatarScaleCommand}"
                    ToolTip.Tip="0 keeps the avatar's own size as uploaded. Any other value forces that size.">
          <Grid ColumnDefinitions="Auto,*">
            <c:NumberField Value="{Binding AvatarScale}" Minimum="0" Maximum="20" Step="0.01" Decimals="3"
                           Width="110" />
            <TextBlock Grid.Column="1" Text="{Binding AvatarScaleReadout}" Classes="secondary"
                       Margin="{DynamicResource GapLeft}" VerticalAlignment="Center" />
          </Grid>
        </c:FieldRow>
      </StackPanel>
    </c:Section>
  </StackPanel>
</UserControl>
