<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:takes="using:VRMR.App.Views.Takes"
             xmlns:c="using:VRMR.App.Controls"
             xmlns:vm="using:VRMR.App.ViewModels"
             x:Class="VRMR.App.Views.Takes.RecordCalibrationView"
             x:DataType="vm:TakeInspectorViewModel">
  <c:Section Header="Calibration settings" IsExpanded="False" StateKey="record.calibration" Summary="{Binding CalibrationSummary}"
             SummaryTone="{Binding CalibrationTone}"
             ToolTip.Tip="Like VRChat: the headset and controllers need no calibration. Body trackers are bound to the avatar's T-pose at one moment. Every VRChat calibration is saved to a library, and new takes use the latest one that fits. The recorded data is kept, so every change here solves again without recording again.">
    <StackPanel>
      <TextBlock Text="{Binding Name}" IsVisible="{Binding HasTake}" FontWeight="SemiBold" />
      <TextBlock Classes="note" Text="{Binding SettingsOwner}" />
      <TextBlock Text="{Binding SourceNote}" Classes="note" Classes.warning="{Binding SourceWarning}"
                 ToolTip.Tip="{Binding SourceTip}"
                 IsVisible="{Binding SourceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding CalibrationPose}" Classes="note" Classes.warning="{Binding CalibrationPoseWarning}"
                 IsVisible="{Binding CalibrationPose, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="{DynamicResource GapRow}">
        <Button Content="At playhead" Command="{Binding CalibrateAtPlayheadCommand}"
                ToolTip.Tip="Calibrate at the playhead: move it to a moment where you stand in a T-pose" />
        <Button Content="Find T-pose" Command="{Binding FindTPoseCommand}"
                ToolTip.Tip="Calibrate at the best T-pose found in this take: arms out, looking ahead, holding still" />
      </StackPanel>

      <takes:CalibrationSettingsView DataContext="{Binding Settings}" />

      <c:Section Header="VRChat's settings in this take" Level="2" IsExpanded="False" StateKey="take.cal.vrc"
                 Summary="{Binding VrcSettingsSummary}"
                 ToolTip.Tip="VRChat's spine mode and measurement while recording, and where they changed. For takes recorded before the app logged them, add a change at the playhead.">
        <StackPanel>
          <TextBlock Classes="note" Text="{Binding VrcSettingsText}" />
          <Grid ColumnDefinitions="*,8,Auto">
            <ComboBox ItemsSource="{Binding VrcChangeKinds}" SelectedIndex="{Binding VrcChangeKind}" />
            <Button Grid.Column="2" Content="Add at playhead" Command="{Binding AddVrcChangeCommand}"
                    ToolTip.Tip="VRChat's setting changed to this at the playhead" />
          </Grid>
          <Button Classes="link" Content="Remove the added changes" Command="{Binding ClearVrcChangesCommand}"
                  IsVisible="{Binding HasVrcChanges}" HorizontalAlignment="Left" Margin="{DynamicResource GapTop}" />
        </StackPanel>
      </c:Section>

      <c:Section Header="Defaults and presets" Level="2" IsExpanded="False" StateKey="take.cal.presets">
        <StackPanel>
          <WrapPanel Margin="{DynamicResource GapRow}">
            <Button Content="Make these the defaults" Command="{Binding MakeDefaultCommand}"
                    ToolTip.Tip="Every take without settings of its own then uses these" />
            <Button Content="Use the defaults" Command="{Binding UseDefaultsCommand}"
                    IsEnabled="{Binding TakeHasOwnSettings}" ToolTip.Tip="Drop this take's own settings" />
          </WrapPanel>
          <c:FieldRow Label="Preset" ToolTip.Tip="Named calibration settings you can load into any take">
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                      PlaceholderText="No preset picked" />
          </c:FieldRow>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="{DynamicResource GapRow}">
            <Button Content="Load" Command="{Binding LoadPresetCommand}"
                    ToolTip.Tip="Use the picked preset's settings" />
            <Button Content="Delete" Command="{Binding DeletePresetCommand}"
                    ToolTip.Tip="Move the picked preset to the Recycle Bin" />
          </StackPanel>
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Text="{Binding PresetName}" PlaceholderText="Name for a new preset" />
            <Button Grid.Column="2" Content="Save as preset" Command="{Binding SavePresetCommand}"
                    ToolTip.Tip="Save the settings shown under this name (replaces a preset of the same name)" />
          </Grid>
        </StackPanel>
      </c:Section>

      <c:Section Header="Calibration library" Level="2" IsExpanded="False" StateKey="take.cal.library">
        <StackPanel>
          <TextBlock Classes="note"
                     Text="Calibrations saved from VRChat, from takes, or captured here. Choose a calibration in View to apply it to a take." />
          <WrapPanel>
            <Button Content="Save this take's" Command="{Binding SaveTakeCalibrationCommand}" Margin="0,0,8,8"
                    ToolTip.Tip="Saves the calibration this take uses to the library, so other takes can use it" />
            <Button Content="Delete picked" Command="{Binding DeleteSourceCommand}"
                    IsEnabled="{Binding CanDeleteSource}" Margin="0,0,8,8"
                    ToolTip.Tip="Moves the calibration picked in View to the Recycle Bin. Takes that use it keep their own copy." />
          </WrapPanel>
          <TextBlock Classes="note" Text="{Binding WatchText}"
                     IsVisible="{Binding WatchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </c:Section>

      <c:Section Header="Result" Level="2" IsExpanded="False" StateKey="take.cal.result">
        <SelectableTextBlock Text="{Binding CalibrationResult}" Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="{DynamicResource FontSecondary}" TextWrapping="Wrap" LineHeight="18" />
      </c:Section>
    </StackPanel>
  </c:Section>
</UserControl>
